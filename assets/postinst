#!/bin/bash
# postinst - 安装/升级后处理
# 组件树（/usr/local/sftpgo 下二进制/静态资源/模板/服务）随 deb 分发；
# postinst 负责"派生状态"：属主、webui 解压、系统层注册（服务+nginx）、
# 配置首装引导（sftpgo.json / sftpgo.env / 首管理员凭据）、启动与健康检查。
# 全部幂等：应用中心安装与手动 apt 安装两条路径行为一致。
set -e

APP_DIR=/usr/local/sftpgo
APP_USER=sftpgo
DATA_DIR=/var/lib/sftpgo
MAINT_LOG=/var/log/sftpgo-maint.log

pkg_log() {
  mkdir -p /var/log 2>/dev/null || true
  echo "$(date '+%F %T') $*" >> "$MAINT_LOG" 2>/dev/null || true
}
pkg_log postinst "$1" "new=@VERSION@${2:+ old=$2}"

case "$1" in
  configure)
    # 1. 用户兜底（preinst 已建；平台自动创建路径亦覆盖）
    if ! id -u $APP_USER > /dev/null 2>&1; then
      useradd --system --user-group --no-create-home --shell /usr/sbin/nologin $APP_USER 2>/dev/null || true
    fi

    # 2. 文件属主：应用目录保持 dpkg 安装的 root:root（只读使用）。
    #    真机实证（D-013）：TOS 接管应用（写 .userid/ROUTER）会把 /usr/local/<app>
    #    属主规范回 root——此前 chown -R 给运行用户的做法在 TOS 重启/接管后必炸。
    #    服务需要写的一切（DB/env/host keys）均在 DATA_DIR。

    # 5. SFTP host keys：root 预生成到数据目录（D-013；目录只读时服务用户无法
    #    自助生成，缺失会导致 sftpd fatal → 整个服务退出 → Web 面 502）
    KEYDIR="$DATA_DIR/hostkeys"
    install -d -m 0700 -o $APP_USER -g $APP_USER "$KEYDIR" 2>/dev/null || {
      mkdir -p "$KEYDIR"; chown $APP_USER:$APP_USER "$KEYDIR"; chmod 0700 "$KEYDIR"; }
    # 迁移旧版自动生成的 key（如有，保持客户端已信任的指纹不变）
    for k in id_ed25519 id_ecdsa id_rsa; do
      if [ ! -f "$KEYDIR/$k" ] && [ -f "$APP_DIR/$k" ]; then
        mv "$APP_DIR/$k" "$KEYDIR/$k" 2>/dev/null || true
        pkg_log postinst migrate "host key $k: /usr/local/sftpgo -> $KEYDIR"
      fi
    done
    # 缺失则生成（ssh-keygen 静默、无口令）
    [ -f "$KEYDIR/id_ed25519" ] || ssh-keygen -q -t ed25519 -N '' -C sftpgo-host-ed25519 -f "$KEYDIR/id_ed25519" 2>/dev/null || true
    [ -f "$KEYDIR/id_ecdsa" ]    || ssh-keygen -q -t ecdsa -N '' -C sftpgo-host-ecdsa -f "$KEYDIR/id_ecdsa" 2>/dev/null || true
    [ -f "$KEYDIR/id_rsa" ]      || ssh-keygen -q -t rsa -b 3072 -N '' -C sftpgo-host-rsa -f "$KEYDIR/id_rsa" 2>/dev/null || true
    chown $APP_USER:$APP_USER "$KEYDIR"/* 2>/dev/null || true
    chmod 0600 "$KEYDIR"/* 2>/dev/null || true
    # 升级路径：统一向导语义（D-014）。旧版（<=2.7.5-2）安装可能残留
    # ① json 里 create_default_admin=true ② env 里 DEFAULT_ADMIN 凭据行——
    # 空库重启时会因凭据缺失 fatal，或静默建出 admin 绕过向导，都不要。
    if [ -f "$APP_DIR/sftpgo.json" ]; then
      python3 - "$APP_DIR/sftpgo.json" "$KEYDIR" <<'PYEOF' 2>/dev/null || true
import json, sys
path, keydir = sys.argv[1], sys.argv[2]
cfg = json.load(open(path, encoding='utf-8'))
changed = []
sf = cfg.setdefault('sftpd', {})
if not sf.get('host_keys'):
    sf['host_keys'] = [
        keydir + '/id_ed25519', keydir + '/id_ecdsa', keydir + '/id_rsa']
    changed.append('host_keys')
dp = cfg.setdefault('data_provider', {})
if dp.get('create_default_admin') is not False:
    dp['create_default_admin'] = False
    changed.append('create_default_admin=false')
if changed:
    json.dump(cfg, open(path, 'w', encoding='utf-8'), indent=4, ensure_ascii=False)
    open(path, 'a').write('\n')
    print('patched:', ','.join(changed))
PYEOF
    fi
    if [ -f "$APP_DIR/sftpgo.env" ] && grep -q '^SFTPGO_DEFAULT_ADMIN_' "$APP_DIR/sftpgo.env" 2>/dev/null; then
      sed -i '/^SFTPGO_DEFAULT_ADMIN_/d; /^# --- 首装自动生成/d' "$APP_DIR/sftpgo.env" 2>/dev/null || true
      pkg_log postinst migrate "env 已清除旧版 DEFAULT_ADMIN 引导行（向导语义）"
    fi

    # 6. 解压 webui.bz2（官方模板行为；External Open 模式下为占位页）。
    #    顺手清掉旧版（-1）macOS bsdtar 遗留的 AppleDouble 垃圾（uid 501，非 dpkg 管辖）
    rm -f "$APP_DIR"/._* "$APP_DIR"/.DS_Store 2>/dev/null || true
    if [ -f "$APP_DIR/webui.bz2" ]; then
      ( cd "$APP_DIR" && tar -xjf webui.bz2 2>/dev/null || true )
    fi

    # 7. 配置首装引导：仅在不存在时从随包模板复制（升级永不覆盖用户配置）
    if [ ! -e "$APP_DIR/sftpgo.json" ] && [ -e "$APP_DIR/sftpgo.json.example" ]; then
      install -m 0640 -o $APP_USER -g $APP_USER \
        "$APP_DIR/sftpgo.json.example" "$APP_DIR/sftpgo.json"
      pkg_log postinst bootstrap "sftpgo.json 首装"
    fi
    if [ ! -e "$APP_DIR/sftpgo.env" ] && [ -e "$APP_DIR/sftpgo.env.example" ]; then
      install -m 0640 -o $APP_USER -g $APP_USER \
        "$APP_DIR/sftpgo.env.example" "$APP_DIR/sftpgo.env"
      pkg_log postinst bootstrap "sftpgo.env 首装"
    fi

    # 8. 首启向导（D-014）：不预建任何账号/密码。首次打开
    #    http://<NAS的IP>:8181/sftpgo/ 会自动引导创建管理员（用户名密码自定）。
    #    应用描述（.lang）已明确说明。旧版（<=2.7.5-2）安装的
    #    INITIAL_ADMIN_CREDENTIALS.txt / env 中 DEFAULT_ADMIN 行保留不动，
    #    已存在管理员时向导不会出现，互不干扰。
    if [ ! -f "$DATA_DIR/sftpgo.db" ]; then
      echo "SFTPGo 已就绪：首次打开 http://<NAS的IP>:8181/sftpgo/ 将引导创建管理员账户（用户名/密码自定，请妥善保管）。"
      pkg_log postinst bootstrap "首启向导模式（无预置凭据）"
    fi

    # 6. 数据目录
    install -d -o $APP_USER -g $APP_USER -m 0750 "$DATA_DIR"

    # 7. 上游官方 deb 数据迁移提示（只提示不自动搬，坑 10 教训）
    if [ -f /etc/sftpgo/sftpgo.db ]; then
      echo "提示: 检测到上游官方 deb 的数据库 /etc/sftpgo/sftpgo.db。" >&2
      echo "      本包数据目录为 $DATA_DIR；如需沿用旧数据，请先停服后手动复制：" >&2
      echo "      systemctl stop sftpgo && cp /etc/sftpgo/sftpgo.db $DATA_DIR/ && chown $APP_USER:$APP_USER $DATA_DIR/sftpgo.db && systemctl start sftpgo" >&2
    fi

    # 8. 系统层注册（幂等；应用中心安装时平台也会做同样的事）
    install -m 0644 "$APP_DIR/init.d/sftpgo.service" /etc/systemd/system/sftpgo.service
    systemctl daemon-reload

    # 9. 启用（幂等，升级路径 prerm 只停不拆故必须重 enable）并（重）启动
    systemctl enable sftpgo.service > /dev/null 2>&1 || true
    if [ -n "${2:-}" ]; then
      systemctl restart sftpgo.service 2>/dev/null || true
    else
      systemctl start sftpgo.service 2>/dev/null || true
    fi

    # 10. nginx 路由（TOS 平台会加载 nginx/<appid>.conf，此处在系统 nginx 兜底注册）
    #     写入后立即 nginx -t 校验，失败则回滚，绝不留下导致 nginx 无法 reload 的配置
    if command -v nginx > /dev/null 2>&1 && [ -d /etc/nginx/conf.d ]; then
      install -m 0644 "$APP_DIR/nginx/sftpgo.conf" /etc/nginx/conf.d/sftpgo.conf
      if nginx -t > /dev/null 2>&1; then
        nginx -s reload > /dev/null 2>&1 || true
      else
        rm -f /etc/nginx/conf.d/sftpgo.conf
        echo "提示: 本机 nginx 的 conf.d 不在 server 上下文，已跳过自动注册 /sftpgo/。" >&2
        echo "      请把 $APP_DIR/nginx/sftpgo.conf 的 location 段手工加入对应 server 块。" >&2
      fi
    fi

    # 11. 就绪检查（坑 26：restart 成功 ≠ 就绪；轮询后端，30s 上限）
    READY=0
    if command -v curl > /dev/null 2>&1; then
      for i in $(seq 1 30); do
        code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 \
               http://127.0.0.1:8095/sftpgo/web/admin/login 2>/dev/null || true)
        if [ -n "$code" ] && [ "$code" != "000" ]; then READY=1; break; fi
        sleep 1
      done
    fi
    if [ "$READY" = "1" ]; then
      pkg_log postinst "sftpgo 后端就绪 (http $code)"
    else
      echo "警告: sftpgo 后端 30 秒内未就绪，排查: journalctl -u sftpgo -n 50 --no-pager" >&2
      systemctl status sftpgo.service --no-pager -n 10 2>/dev/null | head -20 || true
    fi

    pkg_log postinst done "@VERSION@"
    echo ""
    if [ -n "${2:-}" ]; then
      echo "SFTPGo @VERSION@ 已完成升级（自 $2）。"
    else
      echo "SFTPGo @VERSION@ 已安装。"
    fi
    echo "  打开管理 : TOS 桌面 → SFTPGo 图标（新标签页 https://<NAS的IP>:8181/sftpgo/）"
    echo "  初始账号 : 无预置账号——首次打开上述地址会引导创建管理员（用户名/密码自定）"
    echo "  用户端   : https://<NAS的IP>:8181/sftpgo/web/client/login"
    echo "  SFTP     : sftp -P 2022 <用户名>@<NAS的IP>（SFTPGo 虚拟用户，非系统账户）"
    echo "  WebDAV   : http://<NAS的IP>:8181/sftpgo/webdav/（用户凭据登录，各自独立根目录）"
    echo "  REST API : http://<NAS的IP>:8181/sftpgo/api/v2/"
    echo "  数据位置 : $DATA_DIR（apt remove 保留，purge 删除）"
    echo ""
    ;;
esac

exit 0
