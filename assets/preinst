#!/bin/bash
# preinst - 安装/升级前处理（TOS 规范：专用用户必须在 preinst 创建）
set -e

MAINT_LOG=/var/log/sftpgo-maint.log
mkdir -p /var/log 2>/dev/null || true
echo "$(date '+%F %T') preinst $*" >> "$MAINT_LOG" 2>/dev/null || true

# 创建专用系统用户（平台安装路径亦会自动创建；此处保证手动 apt 安装也可用；
# --user-group 显式建同名主组；若设备上存有上游官方 deb 建的 sftpgo 用户则直接复用）
if ! id -u sftpgo > /dev/null 2>&1; then
  useradd --system --user-group --no-create-home --shell /usr/sbin/nologin sftpgo 2>/dev/null || true
fi

# 数据目录
mkdir -p /var/lib/sftpgo
chown sftpgo:sftpgo /var/lib/sftpgo 2>/dev/null || true

exit 0
