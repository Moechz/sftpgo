# ============================================================
# SFTPGo 配置（systemd EnvironmentFile）
# 改完执行: systemctl restart sftpgo
# 环境变量优先级高于 /usr/local/sftpgo/sftpgo.json（上游设计）
# 完整变量列表: https://docs.sftpgo.com （env-vars 页）
# 注意键名规则：JSON 键的 . 换成 __（如 data_provider.name ->
#   SFTPGO_DATA_PROVIDER__NAME，data_provider 本身带下划线，易错）
# ============================================================

# ---- 首次使用：打开 http://<NAS的IP>:8181/sftpgo/ 按向导创建管理员 ----

# ---- SFTP 端口（默认 2022，对外监听；客户端: sftp -P <端口> 用户@NAS的IP）----
# SFTPGO_SFTPD__BINDINGS__0__PORT=2022

# ---- HTTP（WebAdmin/WebClient/REST API）端口（仅回环；改动需同步 nginx 配置）----
# SFTPGO_HTTPD__BINDINGS__0__PORT=8095

# ---- WebDAV 端口（仅回环；改动需同步 nginx 配置）----
# SFTPGO_WEBDAVD__BINDINGS__0__PORT=8096

# ---- 启用 FTP（默认关闭；被动端口段需在防火墙放行）----
# SFTPGO_FTPD__BINDINGS__0__PORT=2121
# SFTPGO_FTPD__PASSIVE_PORT_RANGE__START=50000
# SFTPGO_FTPD__PASSIVE_PORT_RANGE__END=50100

# ---- 安全加固（可选）：登录失败自动封禁（防暴力破解，尤其 SFTP 对外时）----
# SFTPGO_COMMON__DEFENDER__ENABLED=true
# SFTPGO_COMMON__DEFENDER__BAN_TIME=30
# SFTPGO_COMMON__DEFENDER__THRESHOLD=15

# ---- 深度定制：直接编辑 /usr/local/sftpgo/sftpgo.json（升级不覆盖）----
# 支持：云存储后端（S3/GCS/Azure）、事件规则、邮件、OIDC、品牌自定义等
