# ============================================================
# SFTPGo TOS 7 应用中心 deb 打包配置
# 修改后重新运行 ./build.sh 即可
# ============================================================

# SFTPGo 上游版本（GitHub tag，不带 v 前缀）
SFTPGO_VERSION=2.7.5

# 封装迭代号（我们自己的发布序号）
# 完整版本 = 上游版本-迭代号，如 2.7.5-1
# 三处一致（config.ini / control / lang），每次提交严格递增；
# Release tag = v<完整版本>；迭代号永不零填充（-01 == -1）
PKG_RELEASE=5

# 目标架构：amd64（x86_64 机型）/ arm64（aarch64 机型）
TARGET_ARCH=amd64

# TOS 应用 id（十处一致：目录/config.ini/单元/用户/图标/lang…上架后不可变）
APP_ID=sftpgo
APP_USER=sftpgo

# 端口规划（8000-19999 官方推荐段）
# 8095 = httpd（WebAdmin/WebClient/REST API，仅回环，经 /sftpgo/ 反代）
# 8096 = webdavd（仅回环，经 /sftpgo/webdav/ 反代）
# 2022 = SFTP（对外，SSH 协议无法经 HTTP 反代）
HTTPD_PORT=8095
WEBDAVD_PORT=8096
SFTPD_PORT=2022

# deb 维护者信息
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"
PUBLISHER="Moechz"

# 上游 Release 下载基址（被限流时可换镜像，见 build.sh fetch 的备选逻辑）
# RELEASE_BASE=https://github.com/drakkan/sftpgo/releases/download/v2.7.5
